# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Backblaze B2 ---
# From your B2 account: App Keys -> Add a New Application Key
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Google Drive (only needed if you use the google-api-python-client path
#     instead of an rclone remote; rclone remotes store their own auth in
#     rclone.conf, which is also gitignored) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- cloud-sync runtime ---
# Where the SQLite manifest + logs live. Defaults to ~/.cloud-sync if unset.
CLOUD_SYNC_HOME=

# --- Dashboard sync (optional) ---
# If set, `cloud-sync run` will push a copy of the run-history DB to this
# path after each job so the Vercel dashboard (via Vercel Postgres/Blob, or
# a manually-uploaded snapshot) can read it. See README "Dashboard data" section.
DASHBOARD_SYNC_TARGET=
