# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Backblaze B2 ---
# From your B2 account: App Keys -> Add a New Application Key
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Google Drive (only needed if you use the google-api-python-client path
#     instead of an rclone remote; rclone remotes store their own auth in
#     rclone.conf, which is also gitignored) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- cloud-sync runtime ---
# Where the SQLite manifest + logs live. Defaults to ~/.cloud-sync if unset.
CLOUD_SYNC_HOME=

# --- Dashboard sync (optional) ---
# If set, `cloud-sync run` will push a copy of the run-history DB to this
# path after each job so the Vercel dashboard (via Vercel Postgres/Blob, or
# a manually-uploaded snapshot) can read it. See README "Dashboard data" section.
DASHBOARD_SYNC_TARGET=

# =========================================================================
# The variables below are NOT set in this local .env. They are configured in
# the deployment platforms and are documented here for reference only:
#
#   Vercel project env (dashboard + sync trigger):
#     CLOUD_SYNC_READONLY=1        # set automatically by api/index.py
#     DASHBOARD_HISTORY_JSON       # set automatically by api/index.py
#     GITHUB_TOKEN                 # fine-grained PAT, Actions: Read+Write, this repo only
#     GITHUB_REPO                  # e.g. dineshpamerla/cloud-sync
#     SYNC_TRIGGER_SECRET          # shared secret the dashboard must send to start a sync
#     DASHBOARD_ALLOWED_ORIGINS    # optional, comma-separated extra CORS origins;
#                                  # the deployment's own origin comes from Vercel's
#                                  # injected VERCEL_URL (that prefix is reserved,
#                                  # so it cannot be set by hand)
#
#   GitHub Actions repo secrets (the sync worker):
#     RCLONE_CONF_BASE64           # base64 -i ~/.config/rclone/rclone.conf
#     B2_KEY_ID
#     B2_APPLICATION_KEY
#
# See docs/DEPLOY.md for the exact setup click-path. Never commit real values.
# =========================================================================
