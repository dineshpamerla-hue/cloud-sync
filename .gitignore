# credentials & secrets — never commit these
.env
*.conf
rclone.conf
credentials.json
token.json
*.key

# manifest / runtime state
*.db
*.db-journal
logs/
.cloud-sync/
# The dashboard reads a *runs-only* JSON snapshot (no source file names), which
# IS meant to be committed — by `cloud-sync export-history` in CI. The full
# manifest.db (which contains Google Drive file paths) must stay ignored.
dashboard_data/manifest.db

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.coverage

# node / vercel
node_modules/
.vercel/

# os
.DS_Store
